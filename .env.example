# muster BYOM (bring-your-own-model) credentials — copy to .env and fill in.
# .env is gitignored; never commit a real key.
#
# muster reads the API key from MUSTER_API_KEY (fallback OPENAI_API_KEY) at
# request time. Base URL and model are read from env vars for most adapters
# (`skills run`, `sop run`, `crosslayer run`, `memory-utilization run`);
# `behave run` also accepts --base-url/--model flags, which take precedence
# over these env vars when both are given:
#   node --env-file=.env dist/cli/index.js behave run <suite>.yaml \
#        --base-url https://api.openai.com/v1 --model gpt-4o-mini
#
# Node 22 loads this file natively with --env-file=.env (no dotenv dependency).
#
# Caveat (NI-001, tests/unit/invariants.test.ts): the repo's secret-pattern
# scan walks the ENTIRE working tree (BASE_EXCLUDES = node_modules, .git,
# dist, .worktrees, .kittify — nothing else) and does NOT consult .gitignore.
# A real, repo-local .env at repo root is therefore visible to that scan even
# though .env is itself gitignored, and will trip the secret-pattern check if
# it holds a real key. NI-001 does not "enforce" .env safety — it is a
# best-effort tripwire that happens to also catch a stray .env, not a
# guarantee, and it cannot see credentials that never touch a file at all.
# Prefer shell-exported environment variables (`export MUSTER_API_KEY=...`)
# over a repo-local .env; credentials must never be committed or pasted into
# a manifest, and a gitignored-but-present .env at repo root is still a risk
# this scan is not designed to fully close.

# Required: your OpenAI (or any OpenAI-compatible) API key.
MUSTER_API_KEY=<your-api-key-here>

# Canonical base URL for BYOM behavioral runs (FR-002).
MUSTER_ENDPOINT=https://api.openai.com/v1

# Deprecated alias for MUSTER_ENDPOINT (FR-002) — still honored, but emits a
# one-line stderr deprecation notice when it is the var that supplies the
# value (MUSTER_ENDPOINT is unset). MUSTER_ENDPOINT wins silently, with no
# warning, when both are set. Not removable before v1.3.0 (spec.md FR-002).
MUSTER_BASE_URL=https://api.openai.com/v1

MUSTER_MODEL=gpt-4o-mini
