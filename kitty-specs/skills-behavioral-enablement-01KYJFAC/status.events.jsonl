{"aggregate_id": "01KYJFACZ1SH8YKA3M2AGDMF8P", "aggregate_type": "Mission", "event_id": "01KYJFADP8WCZ6P059H92HHQ3C", "event_type": "MissionCreated", "payload": {"created_at": "2026-07-27T19:02:40.865742+00:00", "friendly_name": "Skills Behavioral Enablement", "mission_id": "01KYJFACZ1SH8YKA3M2AGDMF8P", "mission_number": null, "mission_slug": "skills-behavioral-enablement-01KYJFAC", "mission_type": "software-dev", "purpose_context": "Today doSkillsRun unconditionally records every type:behavioral skills case as {passed:true, skipped:true} and never builds a client, so the already-tested runTriggerConformance grader is unreachable from the shipped CLI. This mission wires the CLI to the existing grader, fixes the MUSTER_BASE_URL vs MUSTER_ENDPOINT inconsistency, adds Ajv schema validation to the skills manifest, and publishes the missing skills-trigger-taxonomy rubric so trigger-methodology citations point at a real, SHA-pinned source instead of a fabricated anchor.", "purpose_tldr": "Make 'muster skills run' actually execute behavioral trigger-routing cases instead of silently marking them skipped, and fix the env-var/manifest seams around it.", "target_branch": "kitty/mission-skills-behavioral-enablement", "wp_count": 0}, "project_slug": "muster", "project_uuid": "c98b935f-233d-4ac3-9d6d-238a7ab2de66", "schema_version": "5.0.0", "timestamp": "2026-07-27T19:02:41.608034+00:00"}
